# Copy to .env and export before a local run. Never commit the filled file.
#   set -a && source .env && set +a && python scripts/collect.py

# Launch sources
TELEGRAM_BOT_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# App Store Connect. Leave unused until sources.apple.enabled is true.
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_ID=6782280983

# Google Play bulk reports. Leave unused until sources.google_play.enabled is true.
GOOGLE_PLAY_CREDENTIALS=
GOOGLE_PLAY_BUCKET=

# Aggregated bot telemetry JSON produced by integrations/telegram_bot_analytics.py
# or by integrations/tgcloud/exportAnalytics.js. No raw user data.
TELEMETRY_FILE=
TELEMETRY_URL=
TELEMETRY_TOKEN=

# Secret for privacy-preserving user hashes inside a bot process. Not a dashboard secret.
ANALYTICS_SECRET=
